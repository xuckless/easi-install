// Layout and state bindings only. No business logic: callbacks dispatch Actions to Rust store.
// Default Slint style on purpose; visual design pass comes after layout review.
import { Button, CheckBox, HorizontalBox, LineEdit, ProgressIndicator, ScrollView, VerticalBox } from "std-widgets.slint";

export struct InstalledRow {
    app-id: string,
    name: string,
    version: string,
    kind: string,
}

export component AppWindow inherits Window {
    title: "easi";
    preferred-width: 600px;
    preferred-height: 480px;

    // Projected state from easi-core::State
    in property <string> screen: "idle";
    in property <[InstalledRow]> installed-apps: [];
    in property <string> easi-update-version: "";
    in-out property <bool> auto-check-updates: true;
    in property <string> app-name: "";
    in property <string> app-version: "";
    in property <string> app-id: "";
    in property <string> app-kind: "";
    in property <image> app-icon;
    in property <bool> has-app-icon: false;
    in property <string> status-text: "";
    in property <string> error-text: "";
    in property <string> conflict-text: "";

    // Trust summary & permissions projection
    in property <string> trust-size: "";
    in property <string> trust-sha256: "";
    in property <string> trust-origin: "";
    in property <string> trust-signature: "";
    in property <string> trust-warnings: "";
    in property <string> permissions-text: "";
    in property <bool> has-script-warning: false;
    in property <string> script-warning-text: "";
    in-out property <bool> script-consent-checked: false;

    // Progress & post-install
    in property <float> progress: 0.0;
    in property <string> install-dir: "";
    in-out property <bool> trash-checked: true;

    // Wizard state
    in property <[string]> wizard-choices: [];
    in-out property <string> wizard-name-input: "";
    in-out property <string> idle-path-input: "";

    // Internal drag-visual state (DMG-style icon -> Applications folder)
    property <length> drag-offset-x: 0px;
    property <length> drag-offset-y: 0px;
    property <bool> dragging: false;

    // Actions dispatched back to the Redux store
    callback browse-package();
    callback open-path(string);
    callback uninstall-app(string);
    callback run-self-update();
    callback toggle-auto-update(bool);
    callback confirm-install();
    callback cancel();
    callback choose-candidate(int);
    callback confirm-name(string);
    callback finish-trash(bool);
    callback back-to-manager();
    callback close-window();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // --- Idle: Standalone App Manager + Package Picker ---
        if root.screen == "idle": VerticalBox {
            spacing: 12px;
            if root.easi-update-version != "": Rectangle {
                border-width: 1px;
                border-color: #3584e4;
                border-radius: 6px;
                HorizontalBox {
                    padding: 8px;
                    Text {
                        text: "easi " + root.easi-update-version + " is available";
                        vertical-alignment: center;
                        font-weight: 700;
                    }
                    Button {
                        text: "Update Now";
                        primary: true;
                        clicked => { root.run-self-update(); }
                    }
                }
            }
            Text {
                text: "easi — App Manager";
                font-size: 18px;
                font-weight: 700;
            }
            Text {
                text: "Install a downloaded package (AppImage, .tar.*, .zip, .7z, ELF, .run/.sh):";
                font-size: 12px;
            }
            HorizontalBox {
                Button {
                    text: "Install Package…";
                    primary: true;
                    clicked => { root.browse-package(); }
                }
                LineEdit {
                    text <=> root.idle-path-input;
                    placeholder-text: "Or paste /path/to/package.AppImage";
                }
                Button {
                    text: "Open";
                    enabled: root.idle-path-input != "";
                    clicked => { root.open-path(root.idle-path-input); }
                }
            }

            Text {
                text: "Installed Apps (" + root.installed-apps.length + ")";
                font-size: 14px;
                font-weight: 700;
            }
            if root.installed-apps.length == 0: Text {
                text: "No apps installed by easi yet.";
                font-size: 12px;
            }
            if root.installed-apps.length > 0: ScrollView {
                min-height: 200px;
                VerticalBox {
                    spacing: 6px;
                    for app in root.installed-apps: Rectangle {
                        border-width: 1px;
                        border-color: #88888833;
                        border-radius: 6px;
                        HorizontalBox {
                            padding: 8px;
                            VerticalBox {
                                spacing: 2px;
                                Text { text: app.name + (app.version != "" ? " " + app.version : ""); font-weight: 700; }
                                Text { text: app.kind + "  •  " + app.app-id; font-size: 11px; }
                            }
                            Button {
                                text: "Uninstall";
                                clicked => { root.uninstall-app(app.app-id); }
                            }
                        }
                    }
                }
            }
            CheckBox {
                text: "Check for easi updates automatically";
                checked <=> root.auto-check-updates;
                toggled => { root.toggle-auto-update(self.checked); }
            }
        }

        // --- Inspecting ---
        if root.screen == "inspecting": VerticalBox {
            alignment: center;
            spacing: 10px;
            Text {
                text: root.status-text;
                horizontal-alignment: center;
            }
            ProgressIndicator { indeterminate: true; }
            Button {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
        }

        // --- Ready (DMG-style drag + Permissions / Trust + Script Consent) ---
        if root.screen == "ready": VerticalBox {
            spacing: 10px;
            Text {
                text: root.app-name + (root.app-version != "" ? " " + root.app-version : "");
                font-size: 18px;
                horizontal-alignment: center;
            }
            Text {
                text: root.has-script-warning
                    ? "Review script permissions below and check consent to install"
                    : "Drag the app into Applications — or press Install";
                horizontal-alignment: center;
                font-size: 12px;
            }

            // DMG-style drag stage
            Rectangle {
                height: 120px;
                border-width: 1px;
                border-color: #88888844;
                border-radius: 8px;

                drop-zone := Rectangle {
                    x: parent.width - 170px;
                    y: 15px;
                    width: 140px;
                    height: 90px;
                    border-width: 2px;
                    border-radius: 8px;
                    border-color: root.dragging && root.drag-offset-x > 120px ? #3584e4 : #88888866;
                    VerticalBox {
                        alignment: center;
                        Text { text: "Applications"; horizontal-alignment: center; font-weight: 700; }
                        Text { text: "~/Applications"; horizontal-alignment: center; font-size: 11px; }
                    }
                }

                Text {
                    x: parent.width / 2 - 16px;
                    y: 46px;
                    text: "→";
                    font-size: 24px;
                }

                Rectangle {
                    x: 30px + root.drag-offset-x;
                    y: 15px + root.drag-offset-y;
                    width: 140px;
                    height: 90px;
                    border-width: 1px;
                    border-color: #3584e4;
                    border-radius: 8px;
                    VerticalBox {
                        alignment: center;
                        spacing: 4px;
                        if root.has-app-icon: Image {
                            source: root.app-icon;
                            width: 36px;
                            height: 36px;
                            image-fit: contain;
                        }
                        Text { text: root.app-name; horizontal-alignment: center; font-weight: 700; }
                        Text { text: root.app-kind; horizontal-alignment: center; font-size: 11px; }
                    }
                    ta := TouchArea {
                        moved => {
                            if (self.pressed && (!root.has-script-warning || root.script-consent-checked)) {
                                root.dragging = true;
                                root.drag-offset-x = self.mouse-x - self.pressed-x;
                                root.drag-offset-y = self.mouse-y - self.pressed-y;
                            }
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) {
                                if (root.dragging && root.drag-offset-x > 120px) {
                                    root.confirm-install();
                                }
                                root.dragging = false;
                                root.drag-offset-x = 0px;
                                root.drag-offset-y = 0px;
                            }
                        }
                    }
                }
            }

            // Script warning banner (only shown for .run / .sh installers)
            if root.has-script-warning: Rectangle {
                border-width: 2px;
                border-color: #c01c28;
                border-radius: 6px;
                VerticalBox {
                    padding: 8px;
                    spacing: 4px;
                    Text {
                        text: "Warning! This app contains a script that does:";
                        font-weight: 700;
                        font-size: 12px;
                        color: #c01c28;
                    }
                    Text { text: root.script-warning-text; font-size: 11px; wrap: word-wrap; }
                    CheckBox {
                        text: "I understand and consent to running this installer script";
                        checked <=> root.script-consent-checked;
                    }
                }
            }

            // Permissions & Trust summary panel
            Rectangle {
                border-width: 1px;
                border-color: #88888844;
                border-radius: 6px;
                VerticalBox {
                    padding: 8px;
                    spacing: 2px;
                    Text { text: "Permissions & Trust Summary"; font-weight: 700; font-size: 12px; }
                    Text { text: root.permissions-text; font-size: 11px; wrap: word-wrap; }
                    Text { text: "ID: " + root.app-id + "   |   Size: " + root.trust-size + "   |   SHA-256: " + root.trust-sha256; font-size: 11px; }
                    if root.trust-origin != "": Text { text: "Origin: " + root.trust-origin; font-size: 11px; }
                    Text { text: "Signature: " + root.trust-signature; font-size: 11px; }
                    if root.trust-warnings != "": Text { text: "Warnings: " + root.trust-warnings; font-size: 11px; color: #c01c28; }
                }
            }

            HorizontalBox {
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button {
                    text: "Install";
                    primary: true;
                    enabled: !root.has-script-warning || root.script-consent-checked;
                    clicked => { root.confirm-install(); }
                }
            }
        }

        // --- Conflict ---
        if root.screen == "conflict": VerticalBox {
            spacing: 12px;
            Text { text: "App Already Installed"; font-size: 18px; horizontal-alignment: center; }
            Text { text: root.conflict-text; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: "SHA-256: " + root.trust-sha256; font-size: 11px; horizontal-alignment: center; }
            HorizontalBox {
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Replace"; primary: true; clicked => { root.confirm-install(); } }
            }
        }

        // --- Wizard: pick executable or icon ---
        if root.screen == "wizard_exec" || root.screen == "wizard_icon": VerticalBox {
            spacing: 8px;
            Text {
                text: root.screen == "wizard_exec" ? "Choose the main program" : "Choose an application icon";
                font-size: 16px;
            }
            for choice[idx] in root.wizard-choices: Button {
                text: choice;
                clicked => { root.choose-candidate(idx); }
            }
            HorizontalBox {
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }

        // --- Wizard: confirm name ---
        if root.screen == "wizard_name": VerticalBox {
            spacing: 10px;
            Text { text: "Confirm application name"; font-size: 16px; }
            LineEdit { text <=> root.wizard-name-input; }
            HorizontalBox {
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button {
                    text: "Continue";
                    primary: true;
                    clicked => { root.confirm-name(root.wizard-name-input); }
                }
            }
        }

        // --- Installing / Cancelling / RollingBack ---
        if root.screen == "installing": VerticalBox {
            alignment: center;
            spacing: 12px;
            Text { text: root.status-text; font-size: 15px; horizontal-alignment: center; }
            ProgressIndicator { progress: root.progress; }
            HorizontalBox {
                alignment: center;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }

        // --- OfferTrash (Success screen) ---
        if root.screen == "offer_trash": VerticalBox {
            alignment: center;
            spacing: 12px;
            Text { text: root.app-name + " installed!"; font-size: 18px; horizontal-alignment: center; }
            Text { text: "Location: " + root.install-dir; font-size: 12px; horizontal-alignment: center; }
            CheckBox {
                text: "Move downloaded file to Trash";
                checked <=> root.trash-checked;
            }
            HorizontalBox {
                alignment: center;
                Button {
                    text: "Done";
                    primary: true;
                    clicked => { root.finish-trash(root.trash-checked); }
                }
            }
        }

        // --- Done / Cancelled / Failed ---
        if root.screen == "done" || root.screen == "cancelled" || root.screen == "failed": VerticalBox {
            alignment: center;
            spacing: 12px;
            Text {
                text: root.screen == "failed" ? "Installation Failed" : root.status-text;
                font-size: 16px;
                horizontal-alignment: center;
            }
            if root.error-text != "": Text {
                text: root.error-text;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            HorizontalBox {
                alignment: center;
                Button { text: "App Manager"; clicked => { root.back-to-manager(); } }
                Button { text: "Close"; primary: true; clicked => { root.close-window(); } }
            }
        }
    }
}
