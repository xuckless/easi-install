// Layout and state bindings only. No business logic: callbacks dispatch Actions to Rust store.
// Easi Install v2.0.0 — Functional Calm design system (tokens.slint + components.slint + Drop brand).
import { ScrollView } from "std-widgets.slint";
import {
    Theme,
    EButton,
    ESwitch,
    ECheck,
    ESegmented,
    Scene,
    Settle,
    StaggerRow,
    EProgress,
    ConfirmButton,
    SuccessMark,
    DragStage,
} from "components.slint";

export struct InstalledRow {
    app-id: string,
    name: string,
    version: string,
    kind: string,
    size-text: string,
    update-note: string,
    has-update: bool,
    icon: image,
    has-icon: bool,
}

export struct DetectedRow {
    app-id: string,
    name: string,
    version: string,
    kind: string,
    size-text: string,
    issues-text: string,
}

// Solid surface panel (no borders; elevation comes from surface contrast on ground).
component Panel inherits Rectangle {
    border-radius: Theme.radius-section;
    background: Theme.surface;
}

// Danger surface panel (solid danger-soft token, no borders).
component DangerPanel inherits Rectangle {
    border-radius: Theme.radius-section;
    background: Theme.danger-soft;
}

// Text field with solid surface-2 fill and 2px accent focus ring (no idle border).
component EField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    callback edited(string);
    callback accepted(string);

    height: Theme.control-height;
    border-radius: Theme.radius-control;
    background: Theme.surface-2;
    border-width: ti.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    animate border-width { duration: Theme.hover; easing: Theme.ease-out; }

    if root.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.placeholder;
        font-family: Theme.font-ui;
        font-size: Theme.font-body;
        color: Theme.ink-3;
        vertical-alignment: center;
        overflow: elide;
    }
    ti := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        font-family: root.mono ? Theme.font-mono : Theme.font-ui;
        font-size: root.mono ? Theme.font-caption : Theme.font-body;
        color: Theme.ink;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
}

// Small kind glyph (window for GUI, prompt for CLI) — replaces bordered kind pills.
component KindGlyph inherits Rectangle {
    in property <bool> is-cli: false;
    width: 28px;
    height: 28px;
    border-radius: Theme.radius-control;
    background: Theme.surface-2;

    if !root.is-cli: Path {
        x: 6px;
        y: 6px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 2 3.5 C 2 2.7 2.7 2 3.5 2 L 12.5 2 C 13.3 2 14 2.7 14 3.5 L 14 12.5 C 14 13.3 13.3 14 12.5 14 L 3.5 14 C 2.7 14 2 13.3 2 12.5 Z M 2 5.5 L 14 5.5";
        stroke: Theme.ink-2;
        stroke-width: 1.4px;
        fill: transparent;
    }
    if root.is-cli: Path {
        x: 6px;
        y: 6px;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 3.5 5 L 7 8 L 3.5 11 M 8.5 11 L 12.5 11";
        stroke: Theme.ink-2;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

export component AppWindow inherits Window {
    title: "easi";
    icon: @image-url("logo-drop.svg");
    preferred-width: 660px;
    preferred-height: 580px;
    min-width: 540px;
    min-height: 460px;
    background: Theme.ground;
    default-font-family: Theme.font-ui;

    // Projected state from easi-core::State
    in property <string> screen: "idle";
    in property <float> dir: 1;
    in-out property <string> manager-page: "apps"; // "apps" | "settings" | "app_info"
    property <float> page-dir: 1;
    in property <string> easi-version: "";
    in property <[InstalledRow]> installed-apps: [];
    in property <[DetectedRow]> detected-apps: [];
    in property <string> total-size-text: "";
    in-out property <string> search-query: "";
    in-out property <string> filter-kind: "all";
    in-out property <bool> sort-by-size: false;
    in property <string> easi-update-version: "";
    in property <string> updating-app-id: "";
    in property <string> self-update-state: "idle"; // "idle" | "updating" | "updated" | "up_to_date" | "failed"
    in property <string> self-update-message: "";
    in-out property <bool> auto-check-updates: true;
    in-out property <bool> purge-data-on-uninstall: false;
    in-out property <bool> confirm-self-uninstall: false;
    in property <string> settings-feedback: "";

    // Selected App Info (Android-style per-app view)
    in property <string> detail-app-id: "";
    in property <string> detail-name: "";
    in property <string> detail-version: "";
    in property <string> detail-kind: "";
    in property <string> detail-developer: "";
    in property <string> detail-origin: "";
    in property <string> detail-signature: "";
    in property <string> detail-install-dir: "";
    in property <string> detail-app-size: "";
    in property <string> detail-data-size: "";
    in property <string> detail-cache-size: "";
    in property <string> detail-total-size: "";
    in property <float> detail-app-ratio: 1.0;
    in property <float> detail-data-ratio: 0.0;
    in property <float> detail-cache-ratio: 0.0;
    in property <bool> detail-has-cache: false;
    in property <bool> detail-has-data: false;
    in property <image> detail-icon;
    in property <bool> detail-has-icon: false;
    in property <bool> detail-adopted: false;
    in property <bool> detail-can-organize: false;
    in property <string> detail-update-source: "";
    in-out property <string> detail-source-input: "";
    in property <string> detail-feedback: "";
    in-out property <bool> detail-purge-checked: false;
    in-out property <bool> detail-confirm-clear-data: false;
    in-out property <bool> detail-confirm-uninstall: false;

    // Installer flow projections
    in property <string> app-name: "";
    in property <string> app-version: "";
    in property <string> app-id: "";
    in property <string> app-kind: "";
    in property <image> app-icon;
    in property <bool> has-app-icon: false;
    in property <string> status-text: "";
    in property <string> error-text: "";
    in property <string> suggested-command: "";
    in-out property <bool> command-copied: false;
    in property <string> conflict-text: "";

    // Trust summary & permissions projection
    in property <string> trust-size: "";
    in property <string> trust-sha256: "";
    in property <string> trust-origin: "";
    in property <string> trust-signature: "";
    in property <string> trust-warnings: "";
    in property <string> permissions-text: "";
    in property <bool> has-script-warning: false;
    in property <string> script-warning-text: "";
    in-out property <bool> script-consent-checked: false;

    // Progress & post-install
    in property <float> progress: 0.0;
    in property <string> install-dir: "";
    in-out property <bool> trash-checked: true;

    // Wizard state
    in property <[string]> wizard-choices: [];
    in-out property <string> wizard-name-input: "";
    in-out property <string> idle-path-input: "";

    property <bool> install-allowed: !root.has-script-warning || root.script-consent-checked;

    // Actions dispatched back to the Redux store
    callback browse-package();
    callback open-path(string);
    callback open-app-info(string);
    callback refresh-apps();
    callback add-existing-app-folder();
    callback adopt-app(string);
    callback adopt-all-apps();
    callback repair-app(string);
    callback organize-app(string);
    callback forget-app(string);
    callback set-update-source(string, string);
    callback autodetect-update-source(string);
    callback clear-app-cache(string);
    callback clear-app-data(string);
    callback uninstall-app(string, bool);
    callback update-app(string);
    callback launch-app(string);
    callback open-app-folder(string);
    callback filter-changed();
    callback copy-suggested-command(string);
    callback check-app-updates();
    callback run-self-update();
    callback restart-easi();
    callback run-setup-handlers();
    callback run-restore-handlers();
    callback run-self-uninstall();
    callback toggle-auto-update(bool);
    callback confirm-install();
    callback cancel();
    callback choose-candidate(int);
    callback confirm-name(string);
    callback finish-trash(bool);
    callback back-to-manager();
    callback close-window();

    // =========================================================================
    // SCENE 1: Idle — Standalone App Manager (Apps / App Info / Settings)
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "idle";
        dir: root.dir;

        VerticalLayout {
            padding: Theme.pad-window;
            spacing: Theme.s4;

            // Top bar with Drop wordmark + segmented navigation
            HorizontalLayout {
                spacing: Theme.s3;
                VerticalLayout {
                    spacing: Theme.s1;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        Image {
                            source: Theme.dark ? @image-url("wordmark-dark.svg") : @image-url("wordmark-light.svg");
                            height: 22px;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: "Install and manage downloaded Linux apps";
                        font-size: Theme.font-caption;
                        color: Theme.ink-2;
                    }
                }
                ESegmented {
                    labels: ["Apps", "Settings"];
                    current: root.manager-page == "settings" ? 1 : 0;
                    changed(i) => {
                        root.page-dir = i == 1 ? 1 : -1;
                        root.manager-page = i == 1 ? "settings" : "apps";
                        root.confirm-self-uninstall = false;
                    }
                }
            }

            // Overlapping manager pages container
            Rectangle {
                vertical-stretch: 1;

                // --- PAGE 1: Apps (Installed + Detected Apps) ---
                Scene {
                    width: 100%;
                    height: 100%;
                    active: root.manager-page == "apps";
                    dir: root.page-dir;

                    VerticalLayout {
                        spacing: Theme.s3;

                        if root.self-update-state == "updated": Rectangle {
                            border-radius: Theme.radius-section;
                            background: Theme.success-soft;
                            HorizontalLayout {
                                padding: Theme.s3;
                                spacing: Theme.s3;
                                Text {
                                    text: root.self-update-message;
                                    font-size: Theme.font-heading;
                                    font-weight: 600;
                                    color: Theme.success;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                EButton {
                                    text: "Restart Now";
                                    kind: "primary";
                                    small: true;
                                    clicked => { root.restart-easi(); }
                                }
                            }
                        }

                        if root.self-update-state != "updated" && root.easi-update-version != "": Rectangle {
                            border-radius: Theme.radius-section;
                            background: Theme.accent-soft;
                            HorizontalLayout {
                                padding: Theme.s3;
                                spacing: Theme.s3;
                                Text {
                                    text: root.self-update-state == "updating"
                                        ? "Updating easi to " + root.easi-update-version + "…"
                                        : "easi " + root.easi-update-version + " is available";
                                    font-size: Theme.font-heading;
                                    font-weight: 600;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                EButton {
                                    text: root.self-update-state == "updating" ? "Updating…" : "Update Now";
                                    kind: "primary";
                                    small: true;
                                    enabled: root.self-update-state != "updating";
                                    clicked => { root.run-self-update(); }
                                }
                            }
                        }

                        // Install a package panel
                        Panel {
                            VerticalLayout {
                                padding: Theme.s4;
                                spacing: Theme.s2;
                                Text {
                                    text: "Install a Package";
                                    font-size: Theme.font-heading;
                                    font-weight: 600;
                                    color: Theme.ink;
                                }
                                Text {
                                    text: "Supports AppImage, .tar.*, .zip, .7z, .jar, bare ELF, and .run/.sh/.bin";
                                    font-size: Theme.font-caption;
                                    color: Theme.ink-2;
                                }
                                HorizontalLayout {
                                    spacing: Theme.s2;
                                    EButton {
                                        text: "Install Package…";
                                        kind: "primary";
                                        clicked => { root.browse-package(); }
                                    }
                                    EField {
                                        text <=> root.idle-path-input;
                                        placeholder: "Or paste path to package…";
                                        mono: root.idle-path-input != "";
                                        horizontal-stretch: 1;
                                        accepted(p) => {
                                            if (p != "") { root.open-path(p); }
                                        }
                                    }
                                    EButton {
                                        text: "Open";
                                        enabled: root.idle-path-input != "";
                                        clicked => { root.open-path(root.idle-path-input); }
                                    }
                                }
                            }
                        }

                        // Apps list header & toolbar
                        VerticalLayout {
                            spacing: Theme.s2;
                            vertical-stretch: 1;

                            HorizontalLayout {
                                spacing: Theme.s2;
                                Text {
                                    text: "Installed Apps (" + root.installed-apps.length + ")" + (root.total-size-text != "" ? "  ·  " + root.total-size-text : "");
                                    font-size: Theme.font-heading;
                                    font-weight: 600;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                EButton {
                                    text: "Refresh";
                                    small: true;
                                    clicked => { root.refresh-apps(); }
                                }
                                EButton {
                                    text: "Add Existing…";
                                    small: true;
                                    clicked => { root.add-existing-app-folder(); }
                                }
                                EButton {
                                    text: root.sort-by-size ? "Sort: Largest" : "Sort: Name";
                                    small: true;
                                    enabled: root.installed-apps.length > 1;
                                    clicked => {
                                        root.sort-by-size = !root.sort-by-size;
                                        root.filter-changed();
                                    }
                                }
                                EButton {
                                    text: "Check Updates";
                                    small: true;
                                    enabled: root.installed-apps.length > 0;
                                    clicked => { root.check-app-updates(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.s2;
                                EField {
                                    text <=> root.search-query;
                                    placeholder: "Filter installed apps…";
                                    horizontal-stretch: 1;
                                    edited => { root.filter-changed(); }
                                }
                                ESegmented {
                                    small: true;
                                    item-width: 52px;
                                    labels: ["All", "GUI", "CLI"];
                                    current: root.filter-kind == "gui" ? 1 : root.filter-kind == "cli" ? 2 : 0;
                                    changed(i) => {
                                        root.filter-kind = i == 1 ? "gui" : i == 2 ? "cli" : "all";
                                        root.filter-changed();
                                    }
                                }
                            }

                            if root.installed-apps.length == 0 && root.detected-apps.length == 0: Panel {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    padding: Theme.s6;
                                    spacing: Theme.s1;
                                    Text {
                                        text: "No apps installed by easi yet";
                                        font-size: Theme.font-heading;
                                        font-weight: 600;
                                        color: Theme.ink;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Click “Install Package…” above, double-click any downloaded package, or click “Add Existing…” to adopt an app folder.";
                                        font-size: Theme.font-caption;
                                        color: Theme.ink-2;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.installed-apps.length > 0 || root.detected-apps.length > 0: ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: Theme.s3;

                                    if root.installed-apps.length > 0: Panel {
                                        VerticalLayout {
                                            alignment: start;
                                            padding: Theme.s2;
                                            spacing: 2px;
                                            for app[i] in root.installed-apps: StaggerRow {
                                                index: i;
                                                height: (app.update-note != "" || root.updating-app-id == app.app-id) ? 68px : 52px;
                                                HorizontalLayout {
                                                    padding-left: Theme.s2;
                                                    padding-right: Theme.s2;
                                                    padding-top: 6px;
                                                    padding-bottom: 6px;
                                                    spacing: Theme.s3;
                                                    alignment: stretch;

                                                    VerticalLayout {
                                                        alignment: center;
                                                        if app.has-icon: Image {
                                                            source: app.icon;
                                                            width: 32px;
                                                            height: 32px;
                                                            image-fit: contain;
                                                        }
                                                        if !app.has-icon: KindGlyph { is-cli: app.kind == "CLI"; }
                                                    }
                                                    VerticalLayout {
                                                        spacing: 2px;
                                                        horizontal-stretch: 1;
                                                        alignment: center;
                                                        Text {
                                                            text: app.name + (app.version != "" ? "  v" + app.version : "");
                                                            font-size: Theme.font-body;
                                                            font-weight: 600;
                                                            color: Theme.ink;
                                                            overflow: elide;
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 6px;
                                                            Text {
                                                                text: app.kind + "  ·";
                                                                font-size: Theme.font-caption;
                                                                color: Theme.ink-2;
                                                            }
                                                            Text {
                                                                text: app.app-id;
                                                                font-family: Theme.font-mono;
                                                                font-size: Theme.font-caption;
                                                                color: Theme.ink-2;
                                                                overflow: elide;
                                                            }
                                                            if app.size-text != "": Text {
                                                                text: "·  " + app.size-text;
                                                                font-size: Theme.font-caption;
                                                                color: Theme.ink-2;
                                                            }
                                                        }
                                                        if root.updating-app-id == app.app-id: EProgress {
                                                            indeterminate: true;
                                                        }
                                                        if root.updating-app-id != app.app-id && app.update-note != "": Text {
                                                            text: app.update-note;
                                                            font-size: Theme.font-caption;
                                                            font-weight: 600;
                                                            color: app.has-update ? Theme.accent-text : Theme.ink-2;
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: Theme.s1;
                                                        alignment: end;
                                                        if app.has-update || root.updating-app-id == app.app-id: VerticalLayout {
                                                            alignment: center;
                                                            EButton {
                                                                text: root.updating-app-id == app.app-id ? "Updating…" : "Update";
                                                                kind: "primary";
                                                                small: true;
                                                                enabled: root.updating-app-id == "";
                                                                clicked => { root.update-app(app.app-id); }
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            EButton {
                                                                text: "Launch";
                                                                small: true;
                                                                clicked => { root.launch-app(app.app-id); }
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            EButton {
                                                                text: "App Info";
                                                                small: true;
                                                                clicked => {
                                                                    root.page-dir = 1;
                                                                    root.open-app-info(app.app-id);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Dedicated Detected Apps section (unmanaged user apps in $HOME)
                                    if root.detected-apps.length > 0: VerticalLayout {
                                        alignment: start;
                                        spacing: Theme.s2;
                                        HorizontalLayout {
                                            spacing: Theme.s2;
                                            VerticalLayout {
                                                spacing: 2px;
                                                horizontal-stretch: 1;
                                                Text {
                                                    text: "Detected Apps (" + root.detected-apps.length + ")";
                                                    font-size: Theme.font-heading;
                                                    font-weight: 600;
                                                    color: Theme.ink;
                                                }
                                                Text {
                                                    text: "Existing user apps outside your distro package manager. Click Manage to adopt and repair icons or launchers.";
                                                    font-size: Theme.font-caption;
                                                    color: Theme.ink-2;
                                                    wrap: word-wrap;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                EButton {
                                                    text: "Manage All";
                                                    kind: "primary";
                                                    small: true;
                                                    clicked => { root.adopt-all-apps(); }
                                                }
                                            }
                                        }

                                        Panel {
                                            VerticalLayout {
                                                alignment: start;
                                                padding: Theme.s2;
                                                spacing: 2px;
                                                for d[i] in root.detected-apps: StaggerRow {
                                                    index: i;
                                                    height: d.issues-text != "" ? 66px : 52px;
                                                    HorizontalLayout {
                                                        padding-left: Theme.s2;
                                                        padding-right: Theme.s2;
                                                        padding-top: 6px;
                                                        padding-bottom: 6px;
                                                        spacing: Theme.s3;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            KindGlyph { is-cli: d.kind == "CLI"; }
                                                        }
                                                        VerticalLayout {
                                                            spacing: 2px;
                                                            horizontal-stretch: 1;
                                                            alignment: center;
                                                            Text {
                                                                text: d.name + (d.version != "" ? "  v" + d.version : "");
                                                                font-size: Theme.font-body;
                                                                font-weight: 600;
                                                                color: Theme.ink;
                                                                overflow: elide;
                                                            }
                                                            HorizontalLayout {
                                                                spacing: 6px;
                                                                Text {
                                                                    text: d.kind + "  ·";
                                                                    font-size: Theme.font-caption;
                                                                    color: Theme.ink-2;
                                                                }
                                                                Text {
                                                                    text: d.app-id;
                                                                    font-family: Theme.font-mono;
                                                                    font-size: Theme.font-caption;
                                                                    color: Theme.ink-2;
                                                                    overflow: elide;
                                                                }
                                                                if d.size-text != "": Text {
                                                                    text: "·  " + d.size-text;
                                                                    font-size: Theme.font-caption;
                                                                    color: Theme.ink-2;
                                                                }
                                                            }
                                                            if d.issues-text != "": Text {
                                                                text: "Can fix: " + d.issues-text;
                                                                font-size: Theme.font-caption;
                                                                font-weight: 600;
                                                                color: Theme.accent-text;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            EButton {
                                                                text: "Manage";
                                                                small: true;
                                                                clicked => { root.adopt-app(d.app-id); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- PAGE 2: Android-style Per-App Info ---
                Scene {
                    width: 100%;
                    height: 100%;
                    active: root.manager-page == "app_info";
                    dir: root.page-dir;

                    ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalLayout {
                            spacing: Theme.s3;

                            HorizontalLayout {
                                alignment: start;
                                EButton {
                                    text: "← Back to Apps";
                                    kind: "ghost";
                                    small: true;
                                    clicked => {
                                        root.page-dir = -1;
                                        root.manager-page = "apps";
                                        root.detail-confirm-uninstall = false;
                                        root.detail-confirm-clear-data = false;
                                    }
                                }
                            }

                            // Identity panel
                            Panel {
                                HorizontalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s4;
                                    if root.detail-has-icon: VerticalLayout {
                                        alignment: start;
                                        Image {
                                            source: root.detail-icon;
                                            width: 52px;
                                            height: 52px;
                                            image-fit: contain;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: Theme.s1;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: root.detail-name + (root.detail-version != "" ? "  v" + root.detail-version : "");
                                            font-size: Theme.font-title;
                                            font-weight: 600;
                                            color: Theme.ink;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: root.detail-kind + "  ·";
                                                font-size: Theme.font-caption;
                                                color: Theme.ink-2;
                                            }
                                            Text {
                                                text: root.detail-app-id;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.font-caption;
                                                color: Theme.ink-2;
                                            }
                                        }
                                        if root.detail-developer != "": HorizontalLayout {
                                            spacing: Theme.s2;
                                            Text { text: "Developer"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                                            Text { text: root.detail-developer; font-size: Theme.font-caption; color: Theme.ink; horizontal-stretch: 1; }
                                        }
                                        if root.detail-signature != "": HorizontalLayout {
                                            spacing: Theme.s2;
                                            Text { text: "Signature"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                                            Text { text: root.detail-signature; font-size: Theme.font-caption; color: Theme.ink; horizontal-stretch: 1; }
                                        }
                                        if root.detail-origin != "": HorizontalLayout {
                                            spacing: Theme.s2;
                                            Text { text: "Origin"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                                            Text { text: root.detail-origin; font-family: Theme.font-mono; font-size: Theme.font-caption; color: Theme.ink; wrap: word-wrap; horizontal-stretch: 1; }
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.s2;
                                            Text { text: "Location"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                                            Text { text: root.detail-install-dir; font-family: Theme.font-mono; font-size: Theme.font-caption; color: Theme.ink; wrap: word-wrap; horizontal-stretch: 1; }
                                        }
                                    }
                                }
                            }

                            // Quick actions
                            HorizontalLayout {
                                spacing: Theme.s2;
                                alignment: start;
                                EButton {
                                    text: "Launch";
                                    kind: "primary";
                                    clicked => { root.launch-app(root.detail-app-id); }
                                }
                                EButton {
                                    text: "Open Folder";
                                    clicked => { root.open-app-folder(root.detail-app-id); }
                                }
                                EButton {
                                    text: root.updating-app-id == root.detail-app-id ? "Updating…" : "Update";
                                    enabled: root.updating-app-id == "";
                                    clicked => { root.update-app(root.detail-app-id); }
                                }
                                EButton {
                                    text: "Repair Icon & Launcher";
                                    clicked => { root.repair-app(root.detail-app-id); }
                                }
                                if root.detail-can-organize: EButton {
                                    text: "Move to ~/Applications";
                                    clicked => { root.organize-app(root.detail-app-id); }
                                }
                            }

                            if root.updating-app-id == root.detail-app-id: Panel {
                                VerticalLayout {
                                    padding: Theme.s3;
                                    spacing: Theme.s2;
                                    Text {
                                        text: "Downloading and installing update for " + root.detail-name + "…";
                                        font-size: Theme.font-caption;
                                        font-weight: 600;
                                        color: Theme.ink;
                                    }
                                    EProgress {
                                        indeterminate: true;
                                    }
                                }
                            }

                            // Update Source panel (auto-detected from app config/CDN or custom URL)
                            Panel {
                                VerticalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s2;
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        Text {
                                            text: "Update Source";
                                            font-size: Theme.font-heading;
                                            font-weight: 600;
                                            color: Theme.ink;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        EButton {
                                            text: "Auto-Detect";
                                            small: true;
                                            clicked => { root.autodetect-update-source(root.detail-app-id); }
                                        }
                                    }
                                    Text {
                                        text: root.detail-update-source != "" ? root.detail-update-source : "None — click Auto-Detect or paste a GitHub, GitLab, Codeberg, CDN, or latest-download URL.";
                                        font-family: root.detail-update-source != "" ? Theme.font-mono : Theme.font-ui;
                                        font-size: Theme.font-caption;
                                        color: Theme.ink-2;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        EField {
                                            text <=> root.detail-source-input;
                                            placeholder: "https://… or owner/repo or jetbrains:WS";
                                            mono: root.detail-source-input != "";
                                            horizontal-stretch: 1;
                                            accepted(u) => {
                                                if (u != "") {
                                                    root.set-update-source(root.detail-app-id, u);
                                                    root.detail-source-input = "";
                                                }
                                            }
                                        }
                                        EButton {
                                            text: "Save";
                                            small: true;
                                            enabled: root.detail-source-input != "";
                                            clicked => {
                                                root.set-update-source(root.detail-app-id, root.detail-source-input);
                                                root.detail-source-input = "";
                                            }
                                        }
                                    }
                                }
                            }

                            // Storage panel with proportional 3-segment bar
                            Panel {
                                VerticalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s2;
                                    Text {
                                        text: "Storage";
                                        font-size: Theme.font-heading;
                                        font-weight: 600;
                                        color: Theme.ink;
                                    }
                                    // Proportional bar
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.surface-2;
                                        clip: true;
                                        HorizontalLayout {
                                            spacing: 2px;
                                            Rectangle {
                                                horizontal-stretch: max(0.01, root.detail-app-ratio);
                                                background: Theme.accent;
                                            }
                                            if root.detail-data-ratio > 0.001: Rectangle {
                                                horizontal-stretch: root.detail-data-ratio;
                                                background: Theme.accent-text;
                                            }
                                            if root.detail-cache-ratio > 0.001: Rectangle {
                                                horizontal-stretch: root.detail-cache-ratio;
                                                background: Theme.ink-3;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; } }
                                        Text { text: "App"; font-size: Theme.font-body; color: Theme.ink; horizontal-stretch: 1; }
                                        Text { text: root.detail-app-size; font-size: Theme.font-body; font-weight: 600; color: Theme.ink; }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent-text; } }
                                        Text { text: "User data (~/.config, ~/.local/share)"; font-size: Theme.font-body; color: Theme.ink; horizontal-stretch: 1; }
                                        Text { text: root.detail-data-size; font-size: Theme.font-body; font-weight: 600; color: Theme.ink; }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.ink-3; } }
                                        Text { text: "Cache (~/.cache)"; font-size: Theme.font-body; color: Theme.ink; horizontal-stretch: 1; }
                                        Text { text: root.detail-cache-size; font-size: Theme.font-body; font-weight: 600; color: Theme.ink; }
                                    }
                                    Rectangle { height: 1px; background: Theme.surface-2; }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        Text { text: "Total"; font-size: Theme.font-body; font-weight: 600; color: Theme.ink; horizontal-stretch: 1; }
                                        Text { text: root.detail-total-size; font-size: Theme.font-body; font-weight: 600; color: Theme.ink; }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        alignment: start;
                                        EButton {
                                            text: "Clear Cache";
                                            small: true;
                                            enabled: root.detail-has-cache;
                                            clicked => { root.clear-app-cache(root.detail-app-id); }
                                        }
                                        ConfirmButton {
                                            text: "Clear Data";
                                            confirm-text: "Confirm Clear Data";
                                            enabled: root.detail-has-data;
                                            open <=> root.detail-confirm-clear-data;
                                            confirmed => { root.clear-app-data(root.detail-app-id); }
                                        }
                                    }
                                    if root.detail-feedback != "": Text {
                                        text: root.detail-feedback;
                                        font-size: Theme.font-caption;
                                        color: Theme.success;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Uninstall / Stop Managing panel
                            DangerPanel {
                                VerticalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s2;
                                    Text {
                                        text: "Uninstall";
                                        font-size: Theme.font-heading;
                                        font-weight: 600;
                                        color: Theme.danger-text;
                                    }
                                    ECheck {
                                        text: "Also remove user data & cache";
                                        checked <=> root.detail-purge-checked;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        alignment: start;
                                        ConfirmButton {
                                            text: "Uninstall " + root.detail-name;
                                            confirm-text: "Confirm Uninstall";
                                            trigger-kind: "danger-soft";
                                            open <=> root.detail-confirm-uninstall;
                                            confirmed => {
                                                root.page-dir = -1;
                                                root.manager-page = "apps";
                                                root.uninstall-app(root.detail-app-id, root.detail-purge-checked);
                                            }
                                        }
                                        if root.detail-adopted && !root.detail-confirm-uninstall: EButton {
                                            text: "Stop Managing";
                                            small: true;
                                            clicked => {
                                                root.page-dir = -1;
                                                root.manager-page = "apps";
                                                root.forget-app(root.detail-app-id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // --- PAGE 3: Settings ---
                Scene {
                    width: 100%;
                    height: 100%;
                    active: root.manager-page == "settings";
                    dir: root.page-dir;

                    ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalLayout {
                            spacing: Theme.s3;

                            Panel {
                                VerticalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s2;
                                    Text {
                                        text: "Updates";
                                        font-size: Theme.font-heading;
                                        font-weight: 600;
                                        color: Theme.ink;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        Text {
                                            text: "Check for easi updates automatically";
                                            font-size: Theme.font-body;
                                            color: Theme.ink;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        ESwitch {
                                            checked <=> root.auto-check-updates;
                                            toggled(v) => { root.toggle-auto-update(v); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        Text {
                                            text: "Installed version: easi " + root.easi-version;
                                            font-size: Theme.font-caption;
                                            color: Theme.ink-2;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        if root.self-update-state == "updated": EButton {
                                            text: "Restart Now";
                                            kind: "primary";
                                            small: true;
                                            clicked => { root.restart-easi(); }
                                        }
                                        if root.self-update-state != "updated": EButton {
                                            text: root.self-update-state == "updating"
                                                ? "Updating…"
                                                : (root.easi-update-version != "" ? "Update to " + root.easi-update-version : "Check for easi Update");
                                            kind: root.easi-update-version != "" ? "primary" : "secondary";
                                            small: true;
                                            enabled: root.self-update-state != "updating";
                                            clicked => { root.run-self-update(); }
                                        }
                                    }
                                    if root.self-update-message != "": Text {
                                        text: root.self-update-message;
                                        font-size: Theme.font-caption;
                                        color: root.self-update-state == "failed" ? Theme.danger-text : Theme.success;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            Panel {
                                VerticalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s2;
                                    Text {
                                        text: "Uninstall Defaults";
                                        font-size: Theme.font-heading;
                                        font-weight: 600;
                                        color: Theme.ink;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        Text {
                                            text: "Also remove app settings & cache by default";
                                            font-size: Theme.font-body;
                                            color: Theme.ink;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        ESwitch {
                                            checked <=> root.purge-data-on-uninstall;
                                        }
                                    }
                                }
                            }

                            Panel {
                                VerticalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s2;
                                    Text {
                                        text: "Default Handler for Downloaded Packages";
                                        font-size: Theme.font-heading;
                                        font-weight: 600;
                                        color: Theme.ink;
                                    }
                                    Text {
                                        text: "Makes double-clicking downloaded .AppImage, .tar.*, .zip, and .7z files open in easi (does not modify already-installed apps).";
                                        font-size: Theme.font-caption;
                                        color: Theme.ink-2;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        alignment: start;
                                        EButton {
                                            text: "Set easi as Default Handler";
                                            small: true;
                                            clicked => { root.run-setup-handlers(); }
                                        }
                                        EButton {
                                            text: "Restore Previous Handlers";
                                            small: true;
                                            clicked => { root.run-restore-handlers(); }
                                        }
                                    }
                                    if root.settings-feedback != "": Text {
                                        text: root.settings-feedback;
                                        font-size: Theme.font-caption;
                                        color: Theme.success;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            DangerPanel {
                                VerticalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s2;
                                    Text {
                                        text: "Danger Zone";
                                        font-size: Theme.font-heading;
                                        font-weight: 600;
                                        color: Theme.danger-text;
                                    }
                                    Text {
                                        text: "Uninstall easi and restore your previous file handlers. Apps you installed in ~/Applications remain intact.";
                                        font-size: Theme.font-caption;
                                        color: Theme.ink-2;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        ConfirmButton {
                                            text: "Uninstall easi";
                                            confirm-text: "Confirm Uninstall easi";
                                            trigger-kind: "danger-soft";
                                            open <=> root.confirm-self-uninstall;
                                            confirmed => { root.run-self-uninstall(); }
                                        }
                                    }
                                }
                            }

                            Panel {
                                HorizontalLayout {
                                    padding: Theme.s4;
                                    spacing: Theme.s3;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("logo-drop.svg");
                                            width: 40px;
                                            height: 40px;
                                            image-fit: contain;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: Theme.s1;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "About easi";
                                            font-size: Theme.font-heading;
                                            font-weight: 600;
                                            color: Theme.ink;
                                        }
                                        Text {
                                            text: "Version " + root.easi-version + "  ·  Developer: xuckless";
                                            font-size: Theme.font-caption;
                                            color: Theme.ink-2;
                                        }
                                        Text {
                                            text: "Copyright © 2026 xuckless  ·  Apache-2.0 License";
                                            font-size: Theme.font-caption;
                                            color: Theme.ink-2;
                                        }
                                        Text {
                                            text: "github.com/xuckless/easi-install";
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-caption;
                                            color: Theme.ink-3;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        EButton {
                                            text: root.self-update-state == "updated"
                                                ? "Restart Now"
                                                : (root.self-update-state == "updating" ? "Updating…" : "Check for Update");
                                            kind: root.self-update-state == "updated" ? "primary" : "secondary";
                                            small: true;
                                            enabled: root.self-update-state != "updating";
                                            clicked => {
                                                if (root.self-update-state == "updated") {
                                                    root.restart-easi();
                                                } else {
                                                    root.run-self-update();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // SCENE 2: Inspecting / Handing off
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "inspecting";
        dir: root.dir;

        VerticalLayout {
            alignment: center;
            padding-left: 110px;
            padding-right: 110px;
            spacing: Theme.s4;
            Text {
                text: root.status-text;
                font-size: Theme.font-heading;
                font-weight: 600;
                color: Theme.ink;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            EProgress {
                indeterminate: true;
            }
            HorizontalLayout {
                alignment: center;
                EButton {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
            }
        }
    }

    // =========================================================================
    // SCENE 3: Ready — DMG-style DragStage + Trust & Permissions Summary
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "ready";
        dir: root.dir;

        VerticalLayout {
            padding: Theme.pad-window;
            spacing: Theme.s3;

            VerticalLayout {
                spacing: Theme.s1;
                Text {
                    text: root.app-name + (root.app-version != "" ? "  " + root.app-version : "");
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.has-script-warning
                        ? "Review the script permissions below and check consent before installing"
                        : "Drag the app into Applications — or click Install";
                    font-size: Theme.font-caption;
                    color: Theme.ink-2;
                    horizontal-alignment: center;
                }
            }

            Settle {
                shown: root.screen == "ready";
                step: 1;
                DragStage {
                    width: parent.width;
                    icon: root.app-icon;
                    has-icon: root.has-app-icon;
                    name: root.app-name;
                    kind: root.app-kind;
                    allowed: root.install-allowed;
                    active: root.screen == "ready";
                    dropped => { root.confirm-install(); }
                }
            }

            if root.has-script-warning: DangerPanel {
                VerticalLayout {
                    padding: Theme.s3;
                    spacing: Theme.s2;
                    Text {
                        text: "Warning! This app contains a script that does:";
                        font-size: Theme.font-heading;
                        font-weight: 600;
                        color: Theme.danger-text;
                    }
                    Text {
                        text: root.script-warning-text;
                        font-size: Theme.font-caption;
                        color: Theme.ink;
                        wrap: word-wrap;
                    }
                    ECheck {
                        text: "I understand and consent to running this installer script";
                        checked <=> root.script-consent-checked;
                    }
                }
            }

            Panel {
                vertical-stretch: 1;
                ScrollView {
                    width: 100%;
                    height: 100%;
                    VerticalLayout {
                        padding: Theme.s4;
                        spacing: Theme.s2;
                        Text {
                            text: "Permissions & Trust Summary";
                            font-size: Theme.font-heading;
                            font-weight: 600;
                            color: Theme.ink;
                        }
                        if root.permissions-text != "": Text {
                            text: root.permissions-text;
                            font-size: Theme.font-caption;
                            color: Theme.ink-2;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.s2;
                            Text { text: "App ID"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                            Text { text: root.app-id; font-family: Theme.font-mono; font-size: Theme.font-caption; color: Theme.ink; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: Theme.s2;
                            Text { text: "Size"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                            Text { text: root.trust-size; font-size: Theme.font-caption; color: Theme.ink; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: Theme.s2;
                            Text { text: "SHA-256"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                            Text { text: root.trust-sha256; font-family: Theme.font-mono; font-size: Theme.font-caption; color: Theme.ink; horizontal-stretch: 1; }
                        }
                        if root.trust-origin != "": HorizontalLayout {
                            spacing: Theme.s2;
                            Text { text: "Origin"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                            Text { text: root.trust-origin; font-family: Theme.font-mono; font-size: Theme.font-caption; color: Theme.ink; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: Theme.s2;
                            Text { text: "Signature"; width: 72px; font-size: Theme.font-caption; color: Theme.ink-3; }
                            Text { text: root.trust-signature; font-size: Theme.font-caption; color: Theme.ink; horizontal-stretch: 1; }
                        }
                        if root.trust-warnings != "": HorizontalLayout {
                            spacing: Theme.s2;
                            Text { text: "Warnings"; width: 72px; font-size: Theme.font-caption; font-weight: 600; color: Theme.danger-text; }
                            Text { text: root.trust-warnings; font-size: Theme.font-caption; font-weight: 600; color: Theme.danger-text; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.s2;
                EButton {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                EButton {
                    text: "Install";
                    kind: "primary";
                    enabled: root.install-allowed;
                    clicked => { root.confirm-install(); }
                }
            }
        }
    }

    // =========================================================================
    // SCENE 4: Conflict — App Already Installed
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "conflict";
        dir: root.dir;

        VerticalLayout {
            alignment: center;
            padding-left: 90px;
            padding-right: 90px;
            spacing: Theme.s4;
            Panel {
                VerticalLayout {
                    padding: Theme.s6;
                    spacing: Theme.s3;
                    Text {
                        text: "App Already Installed";
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.conflict-text;
                        font-size: Theme.font-body;
                        color: Theme.ink;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "SHA-256: " + root.trust-sha256;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-caption;
                        color: Theme.ink-2;
                        horizontal-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.s2;
                EButton {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                EButton {
                    text: "Replace";
                    kind: "primary";
                    clicked => { root.confirm-install(); }
                }
            }
        }
    }

    // =========================================================================
    // SCENE 5: Wizard — Pick Executable / Pick Icon
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "wizard_exec" || root.screen == "wizard_icon";
        dir: root.dir;

        VerticalLayout {
            padding: Theme.pad-window;
            spacing: Theme.s3;
            VerticalLayout {
                spacing: Theme.s1;
                Text {
                    text: root.screen == "wizard_exec" ? "Choose the Main Program" : "Choose an Application Icon";
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.ink;
                }
                Text {
                    text: "Multiple candidates were found in this package. Select the right one:";
                    font-size: Theme.font-caption;
                    color: Theme.ink-2;
                }
            }
            Panel {
                vertical-stretch: 1;
                ScrollView {
                    width: 100%;
                    height: 100%;
                    VerticalLayout {
                        padding: Theme.s2;
                        spacing: 2px;
                        for choice[idx] in root.wizard-choices: StaggerRow {
                            index: idx;
                            height: 40px;
                            HorizontalLayout {
                                padding-left: Theme.s3;
                                padding-right: Theme.s3;
                                spacing: Theme.s2;
                                Text {
                                    text: choice;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-caption;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: "›";
                                    font-size: Theme.font-heading;
                                    color: Theme.ink-3;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.choose-candidate(idx); }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                EButton {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
            }
        }
    }

    // =========================================================================
    // SCENE 6: Wizard — Confirm Application Name
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "wizard_name";
        dir: root.dir;

        VerticalLayout {
            alignment: center;
            padding-left: 90px;
            padding-right: 90px;
            spacing: Theme.s4;
            Panel {
                VerticalLayout {
                    padding: Theme.s6;
                    spacing: Theme.s3;
                    Text {
                        text: "Confirm Application Name";
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    EField {
                        text <=> root.wizard-name-input;
                        placeholder: "Application name";
                        accepted(n) => { root.confirm-name(n); }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.s2;
                EButton {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                EButton {
                    text: "Continue";
                    kind: "primary";
                    clicked => { root.confirm-name(root.wizard-name-input); }
                }
            }
        }
    }

    // =========================================================================
    // SCENE 7: Installing / Cancelling / Rolling back / Trashing
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "installing";
        dir: root.dir;

        VerticalLayout {
            alignment: center;
            padding-left: 110px;
            padding-right: 110px;
            spacing: Theme.s4;
            HorizontalLayout {
                Text {
                    text: root.status-text;
                    font-size: Theme.font-heading;
                    font-weight: 600;
                    color: Theme.ink;
                    horizontal-stretch: 1;
                }
                Text {
                    text: Math.round(root.progress * 100) + "%";
                    font-family: Theme.font-mono;
                    font-size: Theme.font-caption;
                    color: Theme.ink-2;
                    vertical-alignment: center;
                }
            }
            EProgress {
                progress: root.progress;
                indeterminate: false;
                muted: root.status-text == "Cancelling…" || root.status-text == "Rolling back…";
            }
            HorizontalLayout {
                alignment: center;
                EButton {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
            }
        }
    }

    // =========================================================================
    // SCENE 8: OfferTrash — SuccessMark + Move to Trash
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "offer_trash";
        dir: root.dir;

        VerticalLayout {
            alignment: center;
            padding-left: 90px;
            padding-right: 90px;
            spacing: Theme.s4;
            Panel {
                VerticalLayout {
                    padding: Theme.s6;
                    spacing: Theme.s3;
                    HorizontalLayout {
                        alignment: center;
                        SuccessMark { shown: root.screen == "offer_trash"; }
                    }
                    Text {
                        text: root.app-name + " Installed!";
                        font-size: Theme.font-title;
                        font-weight: 600;
                        color: Theme.success;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.install-dir;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-caption;
                        color: Theme.ink-2;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        ECheck {
                            text: "Move downloaded package to Trash";
                            checked <=> root.trash-checked;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                EButton {
                    text: "Done";
                    kind: "primary";
                    clicked => { root.finish-trash(root.trash-checked); }
                }
            }
        }
    }

    // =========================================================================
    // SCENE 9: Done / Cancelled / Failed
    // =========================================================================
    Scene {
        width: 100%;
        height: 100%;
        active: root.screen == "done" || root.screen == "cancelled" || root.screen == "failed";
        dir: root.dir;

        VerticalLayout {
            alignment: center;
            padding-left: 90px;
            padding-right: 90px;
            spacing: Theme.s4;
            Panel {
                VerticalLayout {
                    padding: Theme.s6;
                    spacing: Theme.s2;
                    Text {
                        text: root.screen == "failed" ? "Installation Failed" : root.status-text;
                        font-size: Theme.font-heading;
                        font-weight: 600;
                        color: root.screen == "failed" ? Theme.danger-text : Theme.ink;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.error-text != "": Text {
                        text: root.error-text;
                        font-size: Theme.font-caption;
                        color: Theme.ink-2;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: Theme.s2;
                if root.screen == "failed" && root.suggested-command != "": EButton {
                    text: root.command-copied ? "Copied!" : "Copy Command";
                    clicked => {
                        root.command-copied = true;
                        root.copy-suggested-command(root.suggested-command);
                    }
                }
                EButton {
                    text: "App Manager";
                    clicked => { root.back-to-manager(); }
                }
                EButton {
                    text: "Close";
                    kind: "primary";
                    clicked => { root.close-window(); }
                }
            }
        }
    }
}
