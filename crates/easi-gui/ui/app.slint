// Layout and state bindings only. No business logic: callbacks dispatch Actions to Rust store.
// Clean default-style polish (consistent spacing, borders, typography, Switch & CheckBox).
import { Button, CheckBox, HorizontalBox, LineEdit, Palette, ProgressIndicator, ScrollView, Switch, VerticalBox } from "std-widgets.slint";

export struct InstalledRow {
    app-id: string,
    name: string,
    version: string,
    kind: string,
    update-note: string,
    has-update: bool,
}

global Theme {
    out property <length> pad-outer: 20px;
    out property <length> pad-card: 12px;
    out property <length> gap-lg: 14px;
    out property <length> gap-md: 10px;
    out property <length> gap-sm: 6px;
    out property <length> radius-card: 10px;
    out property <length> radius-sm: 6px;

    out property <length> font-title: 19px;
    out property <length> font-section: 14px;
    out property <length> font-body: 13px;
    out property <length> font-caption: 11px;

    out property <color> border-subtle: #88888838;
    out property <color> border-strong: #88888866;
    out property <color> surface-tint: #88888812;
    out property <color> accent: #3584e4;
    out property <color> accent-tint: #3584e418;
    out property <color> danger: #c01c28;
    out property <color> danger-tint: #c01c2814;
    out property <color> success: #26a269;
    out property <color> muted-text: #888888;
}

component Card inherits Rectangle {
    border-width: 1px;
    border-color: Theme.border-subtle;
    border-radius: Theme.radius-card;
    background: Theme.surface-tint;
}

export component AppWindow inherits Window {
    title: "easi";
    preferred-width: 640px;
    preferred-height: 540px;
    min-width: 520px;
    min-height: 440px;

    // Projected state from easi-core::State
    in property <string> screen: "idle";
    in property <[InstalledRow]> installed-apps: [];
    in property <string> easi-update-version: "";
    in-out property <bool> auto-check-updates: true;
    in-out property <bool> purge-data-on-uninstall: false;
    in-out property <bool> confirm-self-uninstall: false;
    in property <string> app-name: "";
    in property <string> app-version: "";
    in property <string> app-id: "";
    in property <string> app-kind: "";
    in property <image> app-icon;
    in property <bool> has-app-icon: false;
    in property <string> status-text: "";
    in property <string> error-text: "";
    in property <string> conflict-text: "";

    // Trust summary & permissions projection
    in property <string> trust-size: "";
    in property <string> trust-sha256: "";
    in property <string> trust-origin: "";
    in property <string> trust-signature: "";
    in property <string> trust-warnings: "";
    in property <string> permissions-text: "";
    in property <bool> has-script-warning: false;
    in property <string> script-warning-text: "";
    in-out property <bool> script-consent-checked: false;

    // Progress & post-install
    in property <float> progress: 0.0;
    in property <string> install-dir: "";
    in-out property <bool> trash-checked: true;

    // Wizard state
    in property <[string]> wizard-choices: [];
    in-out property <string> wizard-name-input: "";
    in-out property <string> idle-path-input: "";

    // Internal drag-visual state (DMG-style icon -> Applications folder)
    property <length> drag-offset-x: 0px;
    property <length> drag-offset-y: 0px;
    property <bool> dragging: false;

    // Actions dispatched back to the Redux store
    callback browse-package();
    callback open-path(string);
    callback uninstall-app(string, bool);
    callback update-app(string);
    callback check-app-updates();
    callback run-self-update();
    callback run-self-uninstall();
    callback toggle-auto-update(bool);
    callback confirm-install();
    callback cancel();
    callback choose-candidate(int);
    callback confirm-name(string);
    callback finish-trash(bool);
    callback back-to-manager();
    callback close-window();

    VerticalBox {
        padding: Theme.pad-outer;
        spacing: Theme.gap-lg;

        // --- Idle: Standalone App Manager + Package Picker ---
        if root.screen == "idle": VerticalBox {
            spacing: Theme.gap-lg;
            padding: 0px;

            // Header
            HorizontalBox {
                padding: 0px;
                VerticalBox {
                    padding: 0px;
                    spacing: 2px;
                    Text {
                        text: "easi";
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }
                    Text {
                        text: "Install and manage downloaded Linux apps";
                        font-size: Theme.font-caption;
                        color: Theme.muted-text;
                    }
                }
            }

            // Optional easi self-update banner
            if root.easi-update-version != "": Rectangle {
                border-width: 1px;
                border-color: Theme.accent;
                border-radius: Theme.radius-card;
                background: Theme.accent-tint;
                HorizontalBox {
                    padding: Theme.pad-card;
                    spacing: Theme.gap-md;
                    Text {
                        text: "easi " + root.easi-update-version + " is available";
                        font-size: Theme.font-body;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Update Now";
                        primary: true;
                        clicked => { root.run-self-update(); }
                    }
                }
            }

            // Install a package card
            Card {
                VerticalBox {
                    padding: Theme.pad-card;
                    spacing: Theme.gap-sm;
                    Text {
                        text: "Install a Package";
                        font-size: Theme.font-section;
                        font-weight: 700;
                    }
                    Text {
                        text: "Supports AppImage, .tar.*, .zip, .7z, .jar, bare ELF, and .run/.sh/.bin";
                        font-size: Theme.font-caption;
                        color: Theme.muted-text;
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: Theme.gap-sm;
                        Button {
                            text: "Install Package…";
                            primary: true;
                            clicked => { root.browse-package(); }
                        }
                        LineEdit {
                            text <=> root.idle-path-input;
                            placeholder-text: "Or paste path to package…";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Open";
                            enabled: root.idle-path-input != "";
                            clicked => { root.open-path(root.idle-path-input); }
                        }
                    }
                }
            }

            // Installed apps section
            VerticalBox {
                padding: 0px;
                spacing: Theme.gap-sm;
                vertical-stretch: 1;

                HorizontalBox {
                    padding: 0px;
                    Text {
                        text: "Installed Apps (" + root.installed-apps.length + ")";
                        font-size: Theme.font-section;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Check Updates";
                        enabled: root.installed-apps.length > 0;
                        clicked => { root.check-app-updates(); }
                    }
                }

                if root.installed-apps.length == 0: Card {
                    vertical-stretch: 1;
                    VerticalBox {
                        alignment: center;
                        padding: Theme.pad-outer;
                        spacing: Theme.gap-sm;
                        Text {
                            text: "No apps installed by easi yet";
                            font-size: Theme.font-body;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Click “Install Package…” above or double-click any downloaded package in your file manager.";
                            font-size: Theme.font-caption;
                            color: Theme.muted-text;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.installed-apps.length > 0: ScrollView {
                    vertical-stretch: 1;
                    min-height: 160px;
                    VerticalBox {
                        padding: 2px;
                        spacing: Theme.gap-sm;
                        for app in root.installed-apps: Card {
                            HorizontalBox {
                                padding: Theme.pad-card;
                                spacing: Theme.gap-md;
                                VerticalBox {
                                    padding: 0px;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: Theme.gap-sm;
                                        Text {
                                            text: app.name + (app.version != "" ? "  v" + app.version : "");
                                            font-size: Theme.font-body;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            border-radius: 4px;
                                            background: Theme.surface-tint;
                                            HorizontalBox {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                padding-top: 1px;
                                                padding-bottom: 1px;
                                                Text {
                                                    text: app.kind;
                                                    font-size: 10px;
                                                    font-weight: 600;
                                                    color: Theme.muted-text;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: app.app-id;
                                        font-size: Theme.font-caption;
                                        color: Theme.muted-text;
                                    }
                                    if app.update-note != "": Text {
                                        text: app.update-note;
                                        font-size: Theme.font-caption;
                                        font-weight: 600;
                                        color: Theme.accent;
                                    }
                                }
                                if app.has-update: Button {
                                    text: "Update";
                                    primary: true;
                                    clicked => { root.update-app(app.app-id); }
                                }
                                Button {
                                    text: "Uninstall";
                                    clicked => { root.uninstall-app(app.app-id, root.purge-data-on-uninstall); }
                                }
                            }
                        }
                    }
                }
            }

            // Footer settings & self-uninstall
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }
            HorizontalBox {
                padding: 0px;
                spacing: Theme.gap-md;
                CheckBox {
                    text: "Also remove app settings & cache on uninstall";
                    checked <=> root.purge-data-on-uninstall;
                }
            }
            HorizontalBox {
                padding: 0px;
                spacing: Theme.gap-md;
                Text {
                    text: "Check for easi updates automatically";
                    font-size: Theme.font-caption;
                    color: Theme.muted-text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Switch {
                    checked <=> root.auto-check-updates;
                    toggled => { root.toggle-auto-update(self.checked); }
                }
                if !root.confirm-self-uninstall: Button {
                    text: "Uninstall easi";
                    clicked => { root.confirm-self-uninstall = true; }
                }
                if root.confirm-self-uninstall: HorizontalBox {
                    padding: 0px;
                    spacing: Theme.gap-sm;
                    Button {
                        text: "Confirm Uninstall easi";
                        primary: true;
                        clicked => {
                            root.confirm-self-uninstall = false;
                            root.run-self-uninstall();
                        }
                    }
                    Button {
                        text: "Cancel";
                        clicked => { root.confirm-self-uninstall = false; }
                    }
                }
            }
        }

        // --- Inspecting ---
        if root.screen == "inspecting": VerticalBox {
            alignment: center;
            spacing: Theme.gap-lg;
            Text {
                text: root.status-text;
                font-size: Theme.font-section;
                font-weight: 600;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            ProgressIndicator { indeterminate: true; }
            HorizontalBox {
                alignment: center;
                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
            }
        }

        // --- Ready (DMG-style drag + Permissions / Trust + Script Consent) ---
        if root.screen == "ready": VerticalBox {
            spacing: Theme.gap-md;
            padding: 0px;

            VerticalBox {
                padding: 0px;
                spacing: 3px;
                Text {
                    text: root.app-name + (root.app-version != "" ? "  " + root.app-version : "");
                    font-size: Theme.font-title;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.has-script-warning
                        ? "Review the script permissions below and check consent before installing"
                        : "Drag the app into Applications — or click Install";
                    font-size: Theme.font-caption;
                    color: Theme.muted-text;
                    horizontal-alignment: center;
                }
            }

            // DMG-style drag stage
            Card {
                height: 132px;

                drop-zone := Rectangle {
                    x: parent.width - 178px;
                    y: 18px;
                    width: 150px;
                    height: 96px;
                    border-width: 2px;
                    border-radius: Theme.radius-card;
                    border-color: root.dragging && root.drag-offset-x > 120px ? Theme.accent : Theme.border-strong;
                    background: root.dragging && root.drag-offset-x > 120px ? Theme.accent-tint : transparent;
                    VerticalBox {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: "Applications";
                            font-size: Theme.font-body;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "~/Applications";
                            font-size: Theme.font-caption;
                            color: Theme.muted-text;
                            horizontal-alignment: center;
                        }
                    }
                }

                Text {
                    x: parent.width / 2 - 14px;
                    y: 50px;
                    text: "→";
                    font-size: 24px;
                    color: Theme.muted-text;
                }

                Rectangle {
                    x: 28px + root.drag-offset-x;
                    y: 18px + root.drag-offset-y;
                    width: 150px;
                    height: 96px;
                    border-width: 1.5px;
                    border-color: Theme.accent;
                    border-radius: Theme.radius-card;
                    background: Palette.background;
                    VerticalBox {
                        alignment: center;
                        padding: 8px;
                        spacing: 4px;
                        if root.has-app-icon: Image {
                            source: root.app-icon;
                            width: 38px;
                            height: 38px;
                            image-fit: contain;
                        }
                        Text {
                            text: root.app-name;
                            font-size: Theme.font-body;
                            font-weight: 700;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.app-kind;
                            font-size: 10px;
                            color: Theme.muted-text;
                            horizontal-alignment: center;
                        }
                    }
                    ta := TouchArea {
                        mouse-cursor: (!root.has-script-warning || root.script-consent-checked) ? grab : not-allowed;
                        moved => {
                            if (self.pressed && (!root.has-script-warning || root.script-consent-checked)) {
                                root.dragging = true;
                                root.drag-offset-x = self.mouse-x - self.pressed-x;
                                root.drag-offset-y = self.mouse-y - self.pressed-y;
                            }
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.up) {
                                if (root.dragging && root.drag-offset-x > 120px) {
                                    root.confirm-install();
                                }
                                root.dragging = false;
                                root.drag-offset-x = 0px;
                                root.drag-offset-y = 0px;
                            }
                        }
                    }
                }
            }

            // Script warning banner (only shown for .run / .sh / .bin installers)
            if root.has-script-warning: Rectangle {
                border-width: 1.5px;
                border-color: Theme.danger;
                border-radius: Theme.radius-card;
                background: Theme.danger-tint;
                VerticalBox {
                    padding: Theme.pad-card;
                    spacing: Theme.gap-sm;
                    Text {
                        text: "Warning! This app contains a script that does:";
                        font-size: Theme.font-body;
                        font-weight: 700;
                        color: Theme.danger;
                    }
                    Text {
                        text: root.script-warning-text;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                    CheckBox {
                        text: "I understand and consent to running this installer script";
                        checked <=> root.script-consent-checked;
                    }
                }
            }

            // Permissions & Trust summary card
            Card {
                vertical-stretch: 1;
                ScrollView {
                    VerticalBox {
                        padding: Theme.pad-card;
                        spacing: 4px;
                        Text {
                            text: "Permissions & Trust Summary";
                            font-size: Theme.font-section;
                            font-weight: 700;
                        }
                        if root.permissions-text != "": Text {
                            text: root.permissions-text;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        Text {
                            text: "App ID: " + root.app-id + "   •   Size: " + root.trust-size;
                            font-size: Theme.font-caption;
                            color: Theme.muted-text;
                        }
                        Text {
                            text: "SHA-256: " + root.trust-sha256;
                            font-size: Theme.font-caption;
                            color: Theme.muted-text;
                        }
                        if root.trust-origin != "": Text {
                            text: "Origin: " + root.trust-origin;
                            font-size: Theme.font-caption;
                            color: Theme.muted-text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Signature: " + root.trust-signature;
                            font-size: Theme.font-caption;
                            color: Theme.muted-text;
                        }
                        if root.trust-warnings != "": Text {
                            text: "Warnings: " + root.trust-warnings;
                            font-size: Theme.font-caption;
                            font-weight: 600;
                            color: Theme.danger;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            HorizontalBox {
                padding: 0px;
                alignment: end;
                spacing: Theme.gap-sm;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button {
                    text: "Install";
                    primary: true;
                    enabled: !root.has-script-warning || root.script-consent-checked;
                    clicked => { root.confirm-install(); }
                }
            }
        }

        // --- Conflict ---
        if root.screen == "conflict": VerticalBox {
            alignment: center;
            spacing: Theme.gap-lg;
            Card {
                VerticalBox {
                    padding: Theme.pad-outer;
                    spacing: Theme.gap-md;
                    Text {
                        text: "App Already Installed";
                        font-size: Theme.font-title;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.conflict-text;
                        font-size: Theme.font-body;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "SHA-256: " + root.trust-sha256;
                        font-size: Theme.font-caption;
                        color: Theme.muted-text;
                        horizontal-alignment: center;
                    }
                }
            }
            HorizontalBox {
                alignment: end;
                spacing: Theme.gap-sm;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button { text: "Replace"; primary: true; clicked => { root.confirm-install(); } }
            }
        }

        // --- Wizard: pick executable or icon ---
        if root.screen == "wizard_exec" || root.screen == "wizard_icon": VerticalBox {
            spacing: Theme.gap-md;
            Text {
                text: root.screen == "wizard_exec" ? "Choose the Main Program" : "Choose an Application Icon";
                font-size: Theme.font-title;
                font-weight: 700;
            }
            Text {
                text: "Multiple candidates were found in this package. Select the right one:";
                font-size: Theme.font-caption;
                color: Theme.muted-text;
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalBox {
                    padding: 2px;
                    spacing: Theme.gap-sm;
                    for choice[idx] in root.wizard-choices: Button {
                        text: choice;
                        clicked => { root.choose-candidate(idx); }
                    }
                }
            }
            HorizontalBox {
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }

        // --- Wizard: confirm name ---
        if root.screen == "wizard_name": VerticalBox {
            alignment: center;
            spacing: Theme.gap-lg;
            Card {
                VerticalBox {
                    padding: Theme.pad-outer;
                    spacing: Theme.gap-md;
                    Text {
                        text: "Confirm Application Name";
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }
                    LineEdit { text <=> root.wizard-name-input; }
                }
            }
            HorizontalBox {
                alignment: end;
                spacing: Theme.gap-sm;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button {
                    text: "Continue";
                    primary: true;
                    clicked => { root.confirm-name(root.wizard-name-input); }
                }
            }
        }

        // --- Installing / Cancelling / RollingBack ---
        if root.screen == "installing": VerticalBox {
            alignment: center;
            spacing: Theme.gap-lg;
            Text {
                text: root.status-text;
                font-size: Theme.font-section;
                font-weight: 600;
                horizontal-alignment: center;
            }
            ProgressIndicator { progress: root.progress; }
            HorizontalBox {
                alignment: center;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
            }
        }

        // --- OfferTrash (Success screen) ---
        if root.screen == "offer_trash": VerticalBox {
            alignment: center;
            spacing: Theme.gap-lg;
            Card {
                VerticalBox {
                    padding: Theme.pad-outer;
                    spacing: Theme.gap-md;
                    Text {
                        text: root.app-name + " Installed!";
                        font-size: Theme.font-title;
                        font-weight: 700;
                        color: Theme.success;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Installed to: " + root.install-dir;
                        font-size: Theme.font-caption;
                        color: Theme.muted-text;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        alignment: center;
                        CheckBox {
                            text: "Move downloaded package to Trash";
                            checked <=> root.trash-checked;
                        }
                    }
                }
            }
            HorizontalBox {
                alignment: center;
                Button {
                    text: "Done";
                    primary: true;
                    clicked => { root.finish-trash(root.trash-checked); }
                }
            }
        }

        // --- Done / Cancelled / Failed ---
        if root.screen == "done" || root.screen == "cancelled" || root.screen == "failed": VerticalBox {
            alignment: center;
            spacing: Theme.gap-lg;
            Card {
                VerticalBox {
                    padding: Theme.pad-outer;
                    spacing: Theme.gap-sm;
                    Text {
                        text: root.screen == "failed" ? "Installation Failed" : root.status-text;
                        font-size: Theme.font-section;
                        font-weight: 700;
                        color: root.screen == "failed" ? Theme.danger : Palette.foreground;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.error-text != "": Text {
                        text: root.error-text;
                        font-size: Theme.font-caption;
                        color: Theme.muted-text;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
            HorizontalBox {
                alignment: center;
                spacing: Theme.gap-sm;
                Button { text: "App Manager"; clicked => { root.back-to-manager(); } }
                Button { text: "Close"; primary: true; clicked => { root.close-window(); } }
            }
        }
    }
}
